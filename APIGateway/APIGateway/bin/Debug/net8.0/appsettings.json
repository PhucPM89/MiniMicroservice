{
  "GatewayJwt": {
    "Issuer": "http://localhost:5172",
    "Audience": "FilePlatform.Api",
    "JwksUri": "http://localhost:5172/.well-known/jwks.json",
    "JwksRefreshMinutes": 15
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "jwks-route": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/.well-known/{**catch-all}"
        }
      },
      "files-route": {
        "ClusterId": "file-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        }
      },
      "transactions-route": {
        "ClusterId": "transaction-cluster",
        "AuthorizationPolicy": "Default",
        "Match": {
          "Path": "/api/transactions/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5172/"
          }
        }
      },
      "file-cluster": {
        "Destinations": {
          "file-service": {
            "Address": "http://localhost:5222/"
          }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "transaction-service": {
            "Address": "http://localhost:5139/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
